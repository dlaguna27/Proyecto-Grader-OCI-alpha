# Copy to .env and change every password before the contest.
# scripts\setup.ps1 generates this file with random secrets for you.

POSTGRES_PASSWORD=change-me-postgres
# Letters and digits only (it is embedded in a URL).
REDIS_PASSWORD=change-me-redis
# Shared secret between API and grading workers (long random string).
WORKER_TOKEN=change-me-worker-token
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin

# Port contestants use on the LAN (http://SERVER-IP:HTTP_PORT).
HTTP_PORT=80
# Onsite: ":80". Cloud: your domain, e.g. contest.example.org (use docker-compose.cloud.yml).
SITE_ADDRESS=:80
ACME_EMAIL=admin@example.org

# Grading capacity: parallel tests per worker container and number of worker containers.
# Rule of thumb: total slots <= physical CPU cores - 1.
JUDGE_SLOTS=2
WORKER_REPLICAS=1

# One computer per team: a new login ends the previous session.
SINGLE_SESSION=1
SUBMIT_PER_MINUTE=6
# Login attempts per minute from one IP address (a school lab behind one public IP shares it).
LOGIN_PER_MINUTE=100
TZ=UTC
