generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CONTESTANT
}

enum ScoringMode {
  IOI
  ICPC
}

enum IoiTaskScoreRule {
  MAX_SUBTASK
  BEST_SUBMISSION
}

enum BalloonPalette {
  ICPC
  CUSTOM
}

enum ProblemType {
  BATCH
  OUTPUT_ONLY
  INTERACTIVE
}

enum CheckerKind {
  TOKENS
  FLOAT
  CUSTOM
}

enum SubtaskScoring {
  MIN
  SUM
}

enum JudgementStatus {
  QUEUED
  COMPILING
  RUNNING
  DONE
  CE
  SE
}

enum TestVerdict {
  AC
  PA
  WA
  TLE
  MLE
  RE
  SE
  SKIPPED
}

/// One account per team or individual contestant (one computer each).
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         Role     @default(CONTESTANT)
  displayName  String
  /// Team members, free text (e.g. "Ana Pérez, Luis Gómez").
  members      String   @default("")
  organization String   @default("")
  region       String   @default("")
  createdAt    DateTime @default(now())

  sessions     Session[]
  participants ContestParticipant[]
  submissions  Submission[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Contest {
  id                    String           @id @default(cuid())
  name                  String
  description           String           @default("")
  scoringMode           ScoringMode
  startsAt              DateTime
  endsAt                DateTime
  freezeAt              DateTime?
  /// ICPC: penalty minutes per rejected attempt.
  penaltyMinutes        Int              @default(20)
  countCompileErrors    Boolean          @default(false)
  ioiTaskScoreRule      IoiTaskScoreRule @default(MAX_SUBTASK)
  /// Null = unlimited.
  maxSubmissionsPerTask Int?
  languages             String[]         @default(["cpp", "python"])
  visible               Boolean          @default(true)
  publicScoreboard      Boolean          @default(true)
  /// ICPC = preset colors by problem order; CUSTOM = Problem.balloonColor.
  balloonPalette        BalloonPalette   @default(ICPC)
  createdAt             DateTime         @default(now())

  problems      Problem[]
  participants  ContestParticipant[]
  submissions   Submission[]
  announcements Announcement[]
}

model ContestParticipant {
  contestId  String
  userId     String
  contest    Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Personal start delay (seconds) and extra time at the end (seconds).
  startDelay Int     @default(0)
  extraTime  Int     @default(0)
  hidden     Boolean @default(false)

  @@id([contestId, userId])
  @@index([userId])
}

model Problem {
  id             String      @id @default(cuid())
  contestId      String
  contest        Contest     @relation(fields: [contestId], references: [id], onDelete: Cascade)
  ordinal        Int         @default(0)
  code           String
  title          String
  type           ProblemType @default(BATCH)
  timeLimitMs    Int         @default(1000)
  memoryLimitMb  Int         @default(256)
  /// Number of decimals used for this problem's scores (0..2).
  scorePrecision Int         @default(0)
  /// "#rrggbb"; used when the contest's balloonPalette is CUSTOM.
  balloonColor   String?
  checkerKind    CheckerKind @default(TOKENS)
  checkerEpsilon Float?
  checkerSha     String?
  interactorSha  String?
  statementSha   String?
  statementType  String?
  /// Markdown statement (alternative to an uploaded PDF).
  statementMd    String      @default("")
  /// Zip of public attachments (e.g. sample files, grader stubs).
  attachmentSha  String?
  activeTestSetId String?    @unique
  activeTestSet  TestSet?    @relation("ActiveTestSet", fields: [activeTestSetId], references: [id])
  createdAt      DateTime    @default(now())

  testSets    TestSet[]    @relation("ProblemTestSets")
  submissions Submission[]

  @@unique([contestId, code])
}

/// An immutable set of test files. Uploading a new zip creates a new test set.
/// Subtasks belong to the test set and may be edited (scores are recomputed).
model TestSet {
  id        String   @id @default(cuid())
  problemId String
  problem   Problem  @relation("ProblemTestSets", fields: [problemId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  note      String   @default("")

  activeFor  Problem?    @relation("ActiveTestSet")
  tests      Test[]
  subtasks   Subtask[]
  judgements Judgement[]
}

model Test {
  id        String  @id @default(cuid())
  testSetId String
  testSet   TestSet @relation(fields: [testSetId], references: [id], onDelete: Cascade)
  ordinal   Int
  name      String
  inputSha  String
  answerSha String?
  inputSize Int     @default(0)
  isSample  Boolean @default(false)

  subtasks SubtaskTest[]
  results  TestResult[]

  @@unique([testSetId, name])
}

model Subtask {
  id          String         @id @default(cuid())
  testSetId   String
  testSet     TestSet        @relation(fields: [testSetId], references: [id], onDelete: Cascade)
  ordinal     Int
  name        String         @default("")
  pointsCenti Int
  scoring     SubtaskScoring @default(MIN)

  tests SubtaskTest[]
}

model SubtaskTest {
  subtaskId String
  testId    String
  subtask   Subtask @relation(fields: [subtaskId], references: [id], onDelete: Cascade)
  test      Test    @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@id([subtaskId, testId])
}

model Submission {
  id          String   @id @default(cuid())
  contestId   String
  problemId   String
  userId      String
  contest     Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language    String?
  sourceSha   String?
  /// Output-only: { testName: sha }.
  outputs     Json?
  submittedAt DateTime @default(now())

  judgements Judgement[]

  @@index([contestId, userId, problemId])
  @@index([contestId, submittedAt])
}

model Judgement {
  id           String          @id @default(cuid())
  submissionId String
  submission   Submission      @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  testSetId    String
  testSet      TestSet         @relation(fields: [testSetId], references: [id])
  token        String
  active       Boolean         @default(false)
  status       JudgementStatus @default(QUEUED)
  compileLog   String?
  error        String?
  /// Per-subtask scores: [{ id, scoreCenti }].
  subtaskScores Json?
  scoreCenti   Int?
  /// Worst verdict / overall verdict for display and ICPC.
  verdict      String?
  maxTimeMs    Int?
  maxMemoryKb  Int?
  worker       String?
  progressDone Int             @default(0)
  progressTotal Int            @default(0)
  createdAt    DateTime        @default(now())
  finishedAt   DateTime?

  results TestResult[]

  @@index([submissionId, active])
  @@index([status])
}

model TestResult {
  judgementId String
  testId      String
  judgement   Judgement   @relation(fields: [judgementId], references: [id], onDelete: Cascade)
  test        Test        @relation(fields: [testId], references: [id], onDelete: Cascade)
  verdict     TestVerdict
  fractionPpm Int
  timeMs      Int?
  memoryKb    Int?
  message     String?

  @@id([judgementId, testId])
}

model Announcement {
  id        String   @id @default(cuid())
  contestId String
  contest   Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  title     String
  body      String
  createdAt DateTime @default(now())
}

/// Content-addressed blob (test data, sources, statements). Stored on disk under its SHA-256.
model File {
  sha       String   @id
  size      Int
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  detail    Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
